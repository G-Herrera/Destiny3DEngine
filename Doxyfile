EXTRACT_PRIVATE = NO
EXTRACT_STATIC = YES
JAVADOC_AUTOBRIEF = YES
MARKDOWN_SUPPORT = YES
USE_MDFILE_AS_MAINPAGE = docs/api.md
SOURCE_BROWSER = YES
REFERENCED_BY_RELATION = YES
