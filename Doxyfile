OUTPUT_LANGUAGE = English
INPUT = Destiny3DEngine/Engine/include Destiny3DEngine/Engine/source docs/api.md
FILE_PATTERNS = *.h *.hpp *.cpp *.md
RECURSIVE = YES
EXCLUDE = Destiny3DEngine/ThirdParties
